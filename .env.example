# Authentication
# Set a strong password — this gates access to the entire app
ACCESS_PASSWORD=your-secret-password

# Vercel Blob Storage
# Auto-created when you connect a Blob store to the project in Vercel dashboard
# Pull locally with: npx vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=

# Ratings API — shared secret for the GitHub Actions worker
RATINGS_API_KEY=

# Telegram webhook (Vercel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NINTENDO_TELEGRAM_CHAT_ID=
# Optional: restrict callbacks to one Telegram user id
NINTENDO_TELEGRAM_USER_ID=
